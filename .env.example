# ==========================================
# Banco de dados (PostgreSQL)
# ==========================================
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/multimilionario"

# ==========================================
# API
# ==========================================
PORT=3333
# Segredo dos tokens JWT — use um valor longo e aleatório em produção
JWT_SECRET="troque-este-segredo"
# Origens liberadas no CORS (separadas por vírgula) — "*" libera todas
CORS_ORIGIN="*"
# URL pública da API (prefixo dos links de PDF de certificado). Vazio = mesmo domínio do site.
PUBLIC_API_URL=""
# URL pública do site (aparece no PDF do certificado para validação)
PUBLIC_WEB_URL="http://localhost:5173"
# Pasta onde os PDFs de certificado são gravados
# UPLOADS_DIR="/data/uploads"

# Admin criado pelo seed (npm run db:seed)
ADMIN_EMAIL="admin@multimilionario.com"
ADMIN_PASSWORD="admin12345"

# ==========================================
# Fila (opcional) — sem REDIS_URL os webhooks são processados na hora
# ==========================================
# REDIS_URL="redis://127.0.0.1:6379"

# ==========================================
# Pagamentos (Cakto)
# ==========================================
# Segredo configurado no webhook da Cakto (enviado no campo "secret" do corpo)
CAKTO_WEBHOOK_SECRET=""
# Somente desenvolvimento: botão "simular pagamento" no checkout
ALLOW_FAKE_CHECKOUT=false

# ==========================================
# Vídeos (Bunny Stream) — opcional; sem isso use URL de vídeo (YouTube, Vimeo, mp4, m3u8)
# ==========================================
BUNNY_API_KEY=""
BUNNY_LIBRARY_ID=""
# Hostname da CDN da biblioteca (padrão: vz-<LIBRARY_ID>.b-cdn.net)
BUNNY_CDN_HOSTNAME=""
# Chave de Token Authentication do player embed (ativa links assinados com expiração)
BUNNY_EMBED_TOKEN_KEY=""
# Segredo do webhook — configure na Bunny: https://SEU-DOMINIO/api/webhooks/bunny?secret=VALOR
BUNNY_WEBHOOK_SECRET=""
